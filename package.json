{
  "name": "tjg-claude-marketplace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write \"**/*.{md,mjs,yml}\"",
    "format:changed": "git diff -z --name-only --diff-filter=d \"$(git merge-base master HEAD)\" -- '*.md' '*.mjs' '*.yml' | xargs -0 -r prettier --write",
    "bump-versions": "node scripts/bump-plugin-versions.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
